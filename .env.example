# Names of the secrets the factory uses. In production every value lives in
# GitHub Actions secrets (Settings -> Secrets and variables -> Actions), never in the repo.
# For a local run, copy this file to .env (git-ignored) and fill in your own values.

# Apify API token: Scout detail lookups, Watcher, Publisher (apify push)
APIFY_TOKEN=

# Anthropic API key: Validator (claude-sonnet-5-5), Claude Code GitHub Action
ANTHROPIC_API_KEY=

# Monday digest email (Phase 4)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# Provided automatically inside GitHub Actions; set them only for a local live run.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=eduardoruiz1990/actor-factory
